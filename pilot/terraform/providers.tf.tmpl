# Pilot harness only: points the real AWS provider at a local moto server.
terraform {
  required_providers {
    aws = { source = "hashicorp/aws", version = "6.67.0" }
  }
}

variable "endpoint" {
  type    = string
  default = "http://127.0.0.1:5055"
}

# S3 Control prefixes the account id to the host name, so it needs a resolvable wildcard-style
# name: build_scenario.py checks that 123456789012.s3control.pilot.internal maps to 127.0.0.1.
variable "s3control_endpoint" {
  type    = string
  default = "http://s3control.pilot.internal:5055"
}

provider "aws" {
  region                      = "us-east-1"
  access_key                  = "pilot"
  secret_key                  = "pilot"
  skip_credentials_validation = true
  skip_metadata_api_check     = true
  skip_region_validation      = true
  s3_use_path_style           = true
  endpoints {
    s3        = var.endpoint
    s3control = var.s3control_endpoint
    route53   = var.endpoint
    ec2       = var.endpoint
    sts       = var.endpoint
    iam       = var.endpoint
    ssm       = var.endpoint
  }
}
